# Copy to .env.local and fill in real values (never commit .env.local)

PORT=3000

# MongoDB Atlas / local connection string. URL-encode special characters in the password (@ -> %40)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
# Database used by the app (always selected explicitly)
MONGO_DB=uber

# Secret used to sign backend JWTs
JWT_SECRET_KEY=change_this_to_a_long_random_secret

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Razorpay (dashboard.razorpay.com -> Settings -> API Keys). Use rzp_test_ keys while testing.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
